{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-harness/handoff.schema.json",
  "title": "implementation_handoff",
  "type": "object",
  "required": ["implementation_handoff"],
  "properties": {
    "implementation_handoff": {
      "type": "object",
      "required": [
        "task_id",
        "original_requirement",
        "architecture_summary",
        "affected_layers",
        "allowed_files",
        "forbidden_files",
        "allowed_patterns",
        "forbidden_patterns",
        "required_behavior",
        "state_machine",
        "data_contracts",
        "side_effects",
        "dependency_policy",
        "test_matrix",
        "acceptance_criteria",
        "reviewer_contract"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "original_requirement": {
          "type": "object",
          "required": ["ref", "sha256"],
          "properties": {
            "ref": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "architecture_summary": { "type": "string", "minLength": 1 },
        "affected_layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["ui", "application", "domain", "infrastructure", "api", "storage"]
          }
        },
        "allowed_files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "forbidden_files": { "type": "array", "items": { "type": "string" } },
        "allowed_patterns": { "type": "array", "items": { "type": "string" } },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pattern", "reason"],
            "properties": {
              "pattern": { "type": "string", "description": "regex applied to changed file content" },
              "reason": { "type": "string" }
            }
          }
        },
        "required_behavior": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "derived_from"],
            "properties": {
              "id": { "type": "string", "pattern": "^R[0-9]+$" },
              "description": { "type": "string" },
              "derived_from": { "type": "string", "description": "requirement id (B*/E*/X*)" }
            }
          }
        },
        "state_machine": {
          "type": "object",
          "required": ["states", "transitions"],
          "properties": {
            "states": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": { "type": "object" }
            },
            "transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["from", "on", "to"],
                "properties": {
                  "from": { "type": "string" },
                  "on": { "type": "string" },
                  "to": { "type": "string" },
                  "note": { "type": "string" }
                }
              }
            },
            "forbidden_transitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "on", "reason"],
                "properties": {
                  "from": { "type": "string" },
                  "on": { "type": "string" },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        },
        "data_contracts": { "type": "object" },
        "side_effects": { "type": "array", "items": { "type": "string" } },
        "dependency_policy": {
          "type": "string",
          "enum": ["none", "explicit_list_only"],
          "description": "none = zero dependency/config changes allowed"
        },
        "allowed_dependencies": { "type": "array", "items": { "type": "string" } },
        "test_matrix": {
          "type": "object",
          "required": ["success_cases", "failure_cases", "false_success_cases", "false_failure_cases"],
          "properties": {
            "success_cases": { "$ref": "#/$defs/caseList" },
            "failure_cases": { "$ref": "#/$defs/caseList" },
            "false_success_cases": { "$ref": "#/$defs/caseList" },
            "false_failure_cases": { "$ref": "#/$defs/caseList" }
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "criterion"],
            "properties": {
              "id": { "type": "string", "pattern": "^AC[0-9]+$" },
              "criterion": { "type": "string" }
            }
          }
        },
        "reviewer_contract": {
          "type": "object",
          "required": ["test_reviewer", "architecture_reviewer", "business_logic_reviewer", "dependency_reviewer", "diff_minimality_reviewer"],
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "caseList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "pattern": "^(S|F|FS|FF)[0-9]+$" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "covers": { "type": "string", "description": "requirement/criteria id" }
        }
      }
    }
  }
}
